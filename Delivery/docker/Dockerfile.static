# MediaButler WebAssembly - Simple Static File Serving
# Following the pattern from collabnix.com WebAssembly Docker tutorial
# Build WebAssembly outside Docker, serve static files with nginx

FROM nginx:alpine

# Copy pre-built WebAssembly files (built outside Docker)
COPY wwwroot /usr/share/nginx/html

# Create simple nginx config for WebAssembly
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    \
    # Enable gzip \
    gzip on; \
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript application/wasm; \
    \
    # WebAssembly MIME type \
    location ~* \.wasm$ { \
        add_header Content-Type application/wasm; \
    } \
    \
    # Handle SPA routing \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Remove default nginx page
RUN rm -f /etc/nginx/conf.d/default.conf.dpkg-dist

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]