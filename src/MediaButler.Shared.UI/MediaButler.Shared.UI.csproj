<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Shared component library for Web and Mobile Blazor apps -->
    <RootNamespace>MediaButler.Shared.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blazor Core Components -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1" />

    <!-- Radzen UI Component Library -->
    <PackageReference Include="Radzen.Blazor" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to MediaButler.Core for shared DTOs and models -->
    <ProjectReference Include="..\MediaButler.Core\MediaButler.Core.csproj" />
  </ItemGroup>

</Project>
