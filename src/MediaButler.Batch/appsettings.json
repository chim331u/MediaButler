{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Hangfire": "Information"
    }
  },
  "ConnectionStrings": {
    "MediaButlerConnection": "Data Source=/data/mediabutler.db;Cache=Shared;",
    "HangfireConnection": "/data/mediabutler-hangfire.db"
  },
  "Hangfire": {
    "Server": {
      "WorkerCount": 2,
      "ServerName": "mediabutler-batch-worker",
      "Queues": ["critical", "default", "low-priority"],
      "HeartbeatInterval": "00:00:30",
      "ServerCheckInterval": "00:05:00"
    },
    "RecurringJobs": {
      "FileDiscovery": {
        "Enabled": true,
        "CronExpression": "*/10 * * * *"
      },
      "ModelTraining": {
        "Enabled": true,
        "CronExpression": "0 3 * * 0"
      },
      "DatabaseMaintenance": {
        "Enabled": true,
        "CronExpression": "0 2 * * 0"
      },
      "LogCleanup": {
        "Enabled": true,
        "CronExpression": "0 1 * * *"
      }
    }
  },
  "SignalRClient": {
    "ApiBaseUrl": "http://localhost:5000",
    "NotificationEndpoint": "/api/notifications/batch",
    "BatchSize": 10,
    "FlushIntervalMs": 500,
    "TimeoutSeconds": 30
  },
  "ARM32Optimization": {
    "MemoryThresholdMB": 150,
    "MaxConcurrentJobs": 2,
    "JobDelayMs": 50
  }
}
