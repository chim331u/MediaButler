@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject NotificationService NotificationService
@inject IOptions<NotificationSettings> NotificationSettings
@using MediaButler.Mobile.Components.Interfaces
@using MediaButler.Mobile.Models
@using Microsoft.Extensions.Options
@using Serilog
@implements IAsyncDisposable


<RadzenLayout>
    <RadzenBody>

        <div>
            @Body
        </div>
    </RadzenBody>
    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
                <RadzenIcon Icon="home" onclick="@(()=> NavigateTo("home"))" />
                @*                 <RadzenStack>Home</RadzenStack> *@
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
                         onclick="@(()=> NavigateTo("setting"))">
                <RadzenIcon Icon="settings" title="Setting" style="font-weight: 100;" />@* <RadzenStack>Setting</RadzenStack> *@
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
                         onclick="@(()=> NavigateTo("logger"))">
                <RadzenIcon Icon="article" title="Log" style="font-weight: 100;" />@* <RadzenStack>Log</RadzenStack> *@
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
                         onclick="@(()=> NavigateTo("lastView"))">
                <RadzenIcon Icon="visibility" title="lastView" style="font-weight: 100;" />
            </RadzenStack>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>

@code {
    // M6: Global toast notifications (Scenario A - toasts appear anywhere)
    // Note: SSE service is Scoped, managed by Index.razor
    // MainLayout just displays toasts for critical events (batch job completion)

    [Inject]
    public ISseNotificationService? SseService { get; set; }

    protected override void OnInitialized()
    {
        System.Threading.Thread.CurrentThread.CurrentCulture = new System.Globalization.CultureInfo("it-IT");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeGlobalNotifications();
        }
    }

    private async Task InitializeGlobalNotifications()
    {
        try
        {
            // Check if SSE is enabled and service is available
            if (SseService == null)
            {
                Log.Debug("SSE service not available in MainLayout (expected if not on Index page)");
                return;
            }

            var settings = NotificationSettings.Value;
            if (!settings.EnableToasts)
            {
                Log.Information("Global toasts disabled in settings");
                return;
            }

            // Subscribe to batch job completion (PRIORITY - Scenario A)
            if (settings.EnabledTypes.Contains("jobNotifications"))
            {
                SseService.OnJobCompleted((resultText, result) =>
                {
                    InvokeAsync(() => ShowJobCompletionToast(resultText, result));
                });

                Log.Information("✅ Global toast notifications enabled (jobNotifications)");
            }

            // Optional: Subscribe to other notification types if enabled
            if (settings.EnabledTypes.Contains("moveFilesNotifications"))
            {
                SseService.OnFileProcessed((fileId, resultText, result) =>
                {
                    InvokeAsync(() => ShowFileProcessedToast(fileId, resultText, result));
                });
            }

            if (settings.EnabledTypes.Contains("notifications"))
            {
                SseService.OnNotification((message, progress) =>
                {
                    InvokeAsync(() => ShowGeneralNotification(message, progress));
                });
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to initialize global notifications");
        }
    }

    private void ShowJobCompletionToast(string resultText, MoveFilesResults result)
    {
        // Check quiet hours
        if (NotificationSettings.Value.QuietHours.IsQuietTime())
        {
            Log.Debug("Notification suppressed (quiet hours)");
            return;
        }

        // Determine notification severity based on result
        var severity = result switch
        {
            MoveFilesResults.Completed => NotificationSeverity.Success,
            MoveFilesResults.Moved => NotificationSeverity.Success,
            MoveFilesResults.Failed => NotificationSeverity.Error,
            MoveFilesResults.IdNotPresent => NotificationSeverity.Warning,
            _ => NotificationSeverity.Info
        };

        var icon = result switch
        {
            MoveFilesResults.Completed => "check_circle",
            MoveFilesResults.Moved => "check_circle",
            MoveFilesResults.Failed => "error",
            MoveFilesResults.IdNotPresent => "warning",
            _ => "info"
        };

        NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = "Batch Job Complete",
            Detail = resultText,
            Duration = 5000,
            //Style = $"background-color: var(--rz-{severity.ToString().ToLower()}); color: white;"
        });

        Log.Information("🔔 Toast shown: {Summary} - {Detail}", "Batch Job Complete", resultText);
    }

    private void ShowFileProcessedToast(int fileId, string resultText, MoveFilesResults result)
    {
        if (NotificationSettings.Value.QuietHours.IsQuietTime())
            return;

        var severity = result == MoveFilesResults.Completed
            ? NotificationSeverity.Success
            : NotificationSeverity.Warning;

        NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = "File Processed",
            Detail = resultText,
            Duration = 3000
        });
    }

    private void ShowGeneralNotification(string message, decimal progress)
    {
        if (NotificationSettings.Value.QuietHours.IsQuietTime())
            return;

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Notification",
            Detail = $"{message} ({progress:F0}%)",
            Duration = 4000
        });
    }

    private void NavigateTo(string page)
    {
        NavManager.NavigateTo($"/{page}");
    }

    public async ValueTask DisposeAsync()
    {
        // Note: SSE service is Scoped, will be disposed by DI container
        // No explicit unsubscribe needed
    }
}

