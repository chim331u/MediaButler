<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MediaButler.Mobile"
             xmlns:components="clr-namespace:MediaButler.Mobile.Components"
             x:Class="MediaButler.Mobile.MainPage"
             Title="MediaButler">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙️"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
