<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediaButler.Mobile.Pages.AddEditEndpointModal"
             Title="Add/Edit Endpoint"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Name Input -->
            <Label Text="Endpoint Name"
                   FontSize="14"
                   FontAttributes="Bold"/>
            <Entry x:Name="NameEntry"
                   Placeholder="e.g., Primary, Home Server"
                   BackgroundColor="{DynamicResource Gray100}"/>

            <!-- Protocol Selection -->
            <Label Text="Protocol"
                   FontSize="14"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>
            <Picker x:Name="ProtocolPicker"
                    Title="Select Protocol"
                    SelectedIndex="0"
                    BackgroundColor="{DynamicResource Gray100}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>http</x:String>
                        <x:String>https</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <!-- Host Input -->
            <Label Text="Server Address"
                   FontSize="14"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>
            <Entry x:Name="HostEntry"
                   Placeholder="192.168.1.100 or mediabutler.local"
                   Keyboard="Url"
                   BackgroundColor="{DynamicResource Gray100}"/>

            <!-- Port Input -->
            <Label Text="Port"
                   FontSize="14"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>
            <Entry x:Name="PortEntry"
                   Placeholder="5271"
                   Keyboard="Numeric"
                   BackgroundColor="{DynamicResource Gray100}"/>

            <!-- Priority Input -->
            <Label Text="Priority (1 = highest)"
                   FontSize="14"
                   FontAttributes="Bold"
                   Margin="0,10,0,0"/>
            <Entry x:Name="PriorityEntry"
                   Placeholder="1"
                   Text="1"
                   Keyboard="Numeric"
                   BackgroundColor="{DynamicResource Gray100}"/>

            <!-- Enabled Toggle -->
            <HorizontalStackLayout Spacing="10"
                                  Margin="0,10,0,0">
                <Label Text="Enabled"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Switch x:Name="EnabledSwitch"
                        IsToggled="True"
                        OnColor="Green"
                        ThumbColor="White"/>
            </HorizontalStackLayout>

            <!-- Test Connection Button -->
            <Button x:Name="TestConnectionButton"
                    Text="Test Connection"
                    Clicked="OnTestConnectionClicked"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White"
                    Margin="0,10,0,0"
                    FontAttributes="Bold"/>

            <!-- Status Label -->
            <HorizontalStackLayout x:Name="StatusContainer"
                                  IsVisible="False"
                                  Spacing="8"
                                  HorizontalOptions="Center">
                <Label x:Name="StatusIcon"
                       FontSize="18"/>
                <Label x:Name="StatusLabel"
                       FontSize="14"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Activity Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                              IsRunning="False"
                              IsVisible="False"
                              Color="{DynamicResource Primary}"
                              HeightRequest="40"/>

            <!-- Save Button -->
            <Button x:Name="SaveButton"
                    Text="Save Endpoint"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#28a745"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,10,0,0"
                    Padding="15"/>

            <!-- Cancel Button -->
            <Button Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Gray600}"
                    BorderColor="{DynamicResource Gray400}"
                    BorderWidth="1"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
