<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediaButler.Mobile.Pages.FirstRunSetupPage"
             Title="Welcome to MediaButler"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Welcome Header -->
            <Label Text="Welcome to MediaButler"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,10"/>

            <Label Text="Connect to your MediaButler server to get started"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   TextColor="{DynamicResource Gray600}"
                   Margin="0,0,0,20"/>

            <!-- Connection Form Card -->
            <Frame Padding="15"
                   CornerRadius="10"
                   HasShadow="True"
                   BorderColor="{DynamicResource Gray300}">

                <VerticalStackLayout Spacing="15">

                    <!-- Protocol Selection -->
                    <Label Text="Protocol"
                           FontSize="14"
                           FontAttributes="Bold"/>
                    <Picker x:Name="ProtocolPicker"
                            Title="Select Protocol"
                            SelectedIndex="0"
                            BackgroundColor="{DynamicResource Gray100}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>http</x:String>
                                <x:String>https</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <!-- Host Input -->
                    <Label Text="Server Address"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,0"/>
                    <Entry x:Name="HostEntry"
                           Placeholder="192.168.1.100 or mediabutler.local"
                           Keyboard="Url"
                           BackgroundColor="{DynamicResource Gray100}"
                           TextChanged="OnInputChanged"/>

                    <!-- Port Input -->
                    <Label Text="Port"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,0"/>
                    <HorizontalStackLayout Spacing="10">
                        <Entry x:Name="PortEntry"
                               Placeholder="5271"
                               Text="5271"
                               Keyboard="Numeric"
                               BackgroundColor="{DynamicResource Gray100}"
                               HorizontalOptions="FillAndExpand"
                               TextChanged="OnInputChanged"/>
                        <Label Text="Common: 5271, 30139, 443"
                               FontSize="12"
                               TextColor="{DynamicResource Gray600}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Test Connection Button -->
                    <Button x:Name="TestConnectionButton"
                            Text="Test Connection"
                            Clicked="OnTestConnectionClicked"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            Margin="0,10,0,0"
                            FontAttributes="Bold"/>

                    <!-- Status Label -->
                    <HorizontalStackLayout x:Name="StatusContainer"
                                          IsVisible="False"
                                          Spacing="8"
                                          HorizontalOptions="Center"
                                          Margin="0,5,0,0">
                        <Label x:Name="StatusIcon"
                               FontSize="18"/>
                        <Label x:Name="StatusLabel"
                               FontSize="14"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Activity Indicator -->
                    <ActivityIndicator x:Name="LoadingIndicator"
                                      IsRunning="False"
                                      IsVisible="False"
                                      Color="{DynamicResource Primary}"
                                      HeightRequest="40"
                                      Margin="0,5,0,0"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Save and Continue Button -->
            <Button x:Name="SaveButton"
                    Text="Save and Continue"
                    IsEnabled="False"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#28a745"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,10,0,0"
                    Padding="15"/>

            <!-- Skip Button -->
            <Button Text="Skip Setup (Use Default)"
                    Clicked="OnSkipClicked"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Gray600}"
                    BorderColor="{DynamicResource Gray400}"
                    BorderWidth="1"
                    Margin="0,5,0,20"/>

            <!-- Help Text -->
            <Label Text="💡 Tip: Your MediaButler server must be running and accessible from this device."
                   FontSize="12"
                   TextColor="{DynamicResource Gray600}"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
