{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Service": "MediaButler.API",
      "Version": "1.0.0",
      "Environment": "Development"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/data/logs/mediabutler-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/data/logs/mediabutler-errors-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "ARM32Optimization": {
      "MemoryThresholdMB": 200,
      "AutoGCTriggerMB": 150,
      "PerformanceThresholdMs": 1000,
      "MaxLogFileSizeMB": 50,
      "LogRetentionDays": 30
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/data/mediabutler.db;Cache=Shared;Foreign Keys=true;",
    "HangfireConnection": "/data/mediabutler-hangfire.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5109",
      "http://localhost:*",
      "https://localhost:*",
      "http://127.0.0.1:*",
      "https://127.0.0.1:*",
      "http://192.168.1.*:*",
      "https://192.168.1.*:*",
      "http://host.docker.internal:*",
      "http://192.168.65.*:*"
    ],
    "AllowWildcardSubdomains": true,
    "AllowCredentials": true,
    "AllowedMethods": [],
    "AllowedHeaders": []
  },
  "MediaButler": {
    "Paths": {
      "MediaLibrary": "/library",
      "WatchFolder": "/watch",
      "PendingReview": "/tmp/mediabutler/pending"
    },
    "FileDiscovery": {
      "WatchFolders": [
        "/watch"
      ],
      "ScanIntervalMinutes": 5,
      "FileExtensions": [ ".mkv", ".mp4", ".avi", ".m4v", ".wmv" ],
      "ExcludePatterns": [ ".*tmp", ".*part", ".*incomplete" ],
      "MinFileSizeMB": 1,
      "MaxConcurrentScans": 1
    },
    "ML": {
      "ModelPath": "models",
      "ActiveModelVersion": 1,
      "AutoClassifyThreshold": 0.85,
      "SuggestionThreshold": 0.50,
      "MaxClassificationTimeMs": 500,
      "MaxAlternativePredictions": 3,
      "EnableBatchProcessing": true,
      "MaxBatchSize": 50,
      "EnableAutoRetraining": true,
      "RetrainingThreshold": 100,
      "Tokenization": {
        "NormalizeSeparators": true,
        "RemoveQualityIndicators": true,
        "RemoveLanguageCodes": true,
        "RemoveReleaseTags": true,
        "ConvertToLowercase": true,
        "MinTokenLength": 2,
        "CustomRemovalPatterns": []
      },
      "Training": {
        "TrainingRatio": 0.7,
        "ValidationRatio": 0.2,
        "NumberOfIterations": 100,
        "LearningRate": 0.1,
        "UseEarlyStopping": true,
        "MinimumAccuracy": 0.75
      },
      "Features": {
        "UseEpisodeFeatures": true,
        "UseQualityFeatures": true,
        "UseFileExtensionFeature": true,
        "EnableDetailedLogging": false,
        "EnablePredictionCaching": true
      },
      "CsvImport": {
        "DefaultCsvPath": "/data/training_data.csv",
        "Separator": ";",
        "NormalizeCategoryNames": true,
        "SkipDuplicates": true,
        "ValidateFileExtensions": true,
        "MaxSamples": 0,
        "AutoImportOnStartup": false,
        "BackupPath": "/data/backups/training_data_backup.csv"
      }
    }
  },
  "Hangfire": {
    "Server": {
      "ServerName": "mediabutler-api-worker",
      "WorkerCount": 2,
      "Queues": [ "critical", "default", "low-priority" ],
      "HeartbeatInterval": "00:00:30",
      "ServerCheckInterval": "00:05:00"
    },
    "RecurringJobs": {
      "FileDiscovery": {
        "Enabled": true,
        "CronExpression": "*/5 * * * *"
      },
      "ModelTraining": {
        "Enabled": true,
        "CronExpression": "0 3 * * 0"
      },
      "DatabaseMaintenance": {
        "Enabled": false,
        "CronExpression": "0 2 * * 0"
      },
      "LogCleanup": {
        "Enabled": true,
        "CronExpression": "0 2 * * *"
      }
    }
  }
}
