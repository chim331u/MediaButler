#!/usr/bin/env bash

# ==============================================================================
# Git Pre-Commit Hook: Auto-Increment Project Version
# Description: Bumps the C# project version on commit, stages the csproj,
#              and avoids loops/duplicate bumps.
# ==============================================================================

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# 1. Bypass check: Allow manual override
if [ "${SKIP_VERSION_BUMP:-0}" = "1" ]; then
    echo -e "${YELLOW}[Pre-Commit Hook] Skipping version increment (SKIP_VERSION_BUMP=1).${NC}"
    exit 0
fi

# 2. Bypass check: Check if the last commit was an auto-bump version commit.
# This prevents double-incrementing if we are amending or running a script-driven commit.
LAST_COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null || echo "")
if [[ "$LAST_COMMIT_MSG" == *"chore: bump version"* ]]; then
    echo -e "${YELLOW}[Pre-Commit Hook] Skipping: Last commit was a version bump.${NC}"
    exit 0
fi

# 3. Bypass check: Check if this is a merge commit or rebasing (usually version bumps are skipped)
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    echo -e "${YELLOW}[Pre-Commit Hook] Skipping version increment during merge commit.${NC}"
    exit 0
fi

# 4. Locate and run the increment script
REPO_ROOT=$(git rev-parse --show-toplevel)
INCREMENT_SCRIPT="$REPO_ROOT/scripts/increment-version.sh"

if [ ! -f "$INCREMENT_SCRIPT" ]; then
    echo -e "${RED}[Pre-Commit Hook] Error: Increment script not found at $INCREMENT_SCRIPT${NC}"
    exit 1
fi

echo -e "${GREEN}[Pre-Commit Hook] Auto-incrementing project version...${NC}"

# Run the script (defaulting to patch)
"$INCREMENT_SCRIPT" patch

# 5. Automatically stage the modified csproj file
# Find the project file path dynamically from the script config or use standard
PROJECT_FILE="src/MediaButler.API/MediaButler.API.csproj"
FULL_PROJECT_PATH="$REPO_ROOT/$PROJECT_FILE"

if [ -f "$FULL_PROJECT_PATH" ]; then
    git add "$PROJECT_FILE"
    echo -e "${GREEN}[Pre-Commit Hook] Staged $PROJECT_FILE for commit.${NC}"
else
    echo -e "${RED}[Pre-Commit Hook] Warning: Could not stage project file (not found at $PROJECT_FILE).${NC}"
fi

exit 0
